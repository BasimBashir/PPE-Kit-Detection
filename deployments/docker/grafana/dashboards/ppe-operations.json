{
 "title": "PPE Intelligence - operations",
 "uid": "ppe-ops",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Processed FPS per camera",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "camera_processed_fps",
     "legendFormat": "{{camera_id}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Aggregate processed FPS vs target",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(camera_processed_fps)",
     "legendFormat": "processed",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(camera_target_fps)",
     "legendFormat": "target",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Frame age at inference p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(camera_frame_age_at_inference_seconds_bucket[1m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Inference stage latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(inference_duration_seconds_bucket[1m])))",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Camera online (1) per camera",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "camera_connection_state{state=\"ONLINE\"}",
     "legendFormat": "{{camera_id}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Reconnects (rate 5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "increase(camera_reconnect_total[5m])",
     "legendFormat": "{{camera_id}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Dropped frames (rate)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(camera_frames_dropped_total[1m])",
     "legendFormat": "{{camera_id}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Last frame age",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "camera_last_frame_age_seconds",
     "legendFormat": "{{camera_id}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "GPU utilisation / VRAM",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "gpu_utilization_percent",
     "legendFormat": "util %",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * gpu_memory_used_bytes / gpu_memory_total_bytes",
     "legendFormat": "VRAM %",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Process RSS",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "app_process_rss_bytes",
     "legendFormat": "{{process}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
