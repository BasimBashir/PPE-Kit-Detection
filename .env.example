# Copy to .env and fill in. .env is git-ignored. Never commit real credentials.
# scripts/bootstrap/init_env.py generates a .env with random secrets.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=ppe
POSTGRES_PASSWORD=
POSTGRES_DB=ppe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- RTSP simulator (MediaMTX). Camera configs reference the reader credentials as credential_ref: env:RTSP_READ
RTSP_PUBLISH_USER=publisher
RTSP_PUBLISH_PASS=
RTSP_READ_USER=viewer
RTSP_READ_PASS=

# --- Application ---
PPE_CONFIG_DIR=configs
# Seeded admin account on first start (username admin). Change after first login.
PPE_ADMIN_PASSWORD=
# Directory holding the demo clips published by the RTSP simulator (outside the repo is fine).
STREAMS_DIR=data/streams
# Evidence + spool directories
PPE_EVIDENCE_DIR=evidence
PPE_SPOOL_DIR=spool
PPE_MODELS_DIR=models

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=
