!models/yolo26s-pose.pt
!models/ppe_yolo26s.pt
!models/head_cls_yolo26n.pt
*.onnx
*.engine

# benchmark raw dumps are committed; scratch output is not
docs/benchmarks/scratch/
configs/*.yaml
!configs/*.example.yaml
